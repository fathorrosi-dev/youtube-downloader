#!/usr/bin/env python3
"""Resolve symlinks portably, then replace this launcher with the local interpreter."""
import os,sys
from pathlib import Path
root=Path(__file__).resolve().parent
py=root/'.venv/bin/python'
if not py.is_file():
    print('Jalankan bash setup.sh dari folder tools terlebih dahulu.',file=sys.stderr);sys.exit(1)
os.execve(str(py),[str(py),str(root/'app.py'),*sys.argv[1:]],{**os.environ,'PYTHONUTF8':'1','PYTHONDONTWRITEBYTECODE':'1'})
